# Supabase (Project Settings -> API)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Edge Function secrets belong in Supabase Dashboard -> Edge Functions -> Secrets.
# Never prefix server-side secrets with VITE_ or place them in browser storage.
# Configure as Supabase Edge Function secrets (required by both
# citizen-signup and officer-admin):
# APP_PUBLIC_URL=https://your-public-app-origin.example
# The citizen-signup function returns to /?page=profile after email verification.
# RESEND_API_KEY=...
# OFFICER_MAIL_FROM=Shikor <officers@your-verified-domain.example>
# Supabase provides SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY.
